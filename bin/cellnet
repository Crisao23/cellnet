#!/bin/sh
#
# cellnet - Carrier control and diagnostics for the UniFi U5G Max Outdoor
#
# Validated environment:
#   PRODUCT:  U5G-Max-Outdoor
#   Firmware: 7.5.3
#   qmicli:   1.38.0
#   QMI:      /dev/wwan0qmi0
#   WWAN:     wwan0
#
# IMPORTANT:
#   - This script does NOT change RAT / Mode Preference / bands.
#   - Carrier switching changes ONLY the PLMN.
#   - speedtest and compare-speed force sockets through wwan0.
#   - Fixed-server speed tests use the configured Ubiquiti server.
#

DEVICE="/dev/wwan0qmi0"
WWAN_IF="wwan0"
QMICLI="qmicli"

TIM_PLMN="72403"
VIVO_PLMN="72410"

WAIT_INTERVAL=5
WAIT_MAX=12

NSA_WAIT_MAX=40
NSA_WAIT_INTERVAL=4
NSA_STABILIZE=8

SPEEDTEST_DURATION=10
SPEEDTEST_SERVER="http://103.14.27.177:80"
SPEEDTEST_MODE_DEFAULT="auto"
CELLNET_BASELINE_VERSION="9.6.0-tower-intelligence"
RADIO_POLL_INTERVAL=3
OPENCELLID_ENDPOINT="${OPENCELLID_ENDPOINT:-https://opencellid.org/cell/get}"
SPEEDTEST_MONITOR_INTERVAL=3
SPEEDTEST_RETRIES=1
SPEEDTEST_RETRY_WAIT=10
SPEEDTEST_WARMUP_DURATION=3
SPEEDTEST_WARMUP_WAIT=2

die() {
    echo "ERROR: $*" >&2
    exit 1
}

separator() {
    echo "------------------------------------------------------------"
}

check_requirements() {
    command -v "$QMICLI" >/dev/null 2>&1 ||
        die "qmicli not found."

    [ -e "$DEVICE" ] ||
        die "QMI device not found: $DEVICE"
}

check_speedtest_requirements() {
    command -v ui-speed >/dev/null 2>&1 ||
        die "ui-speed not found."

    [ -e "/sys/class/net/$WWAN_IF" ] ||
        die "Interface $WWAN_IF not found."
}

qmi() {
    "$QMICLI" \
        -d "$DEVICE" \
        --device-open-proxy \
        "$@"
}

get_serving() {
    qmi --nas-get-serving-system 2>/dev/null
}

get_current_plmn() {
    OUT="$(get_serving)"

    MCC="$(echo "$OUT" |
        awk "/Current PLMN:/,/Roaming indicators:/" |
        awk -F"'" '/MCC:/ {print $2; exit}')"

    MNC="$(echo "$OUT" |
        awk "/Current PLMN:/,/Roaming indicators:/" |
        awk -F"'" '/MNC:/ {print $2; exit}')"

    if [ -n "$MCC" ] && [ -n "$MNC" ]; then
        case "$MNC" in
            [0-9]) MNC="0$MNC" ;;
        esac
        echo "${MCC}${MNC}"
    fi
}

plmn_name() {
    case "$1" in
        72403) echo "TIM" ;;
        72410) echo "VIVO" ;;
        72418) echo "HYPECON/DATORA" ;;
        72405) echo "CLARO" ;;
        *)     echo "UNKNOWN" ;;
    esac
}

wait_registration() {
    EXPECTED="$1"

    echo
    echo "Waiting for network registration..."

    COUNT=0

    while [ "$COUNT" -lt "$WAIT_MAX" ]; do
        OUT="$(get_serving)"

        if echo "$OUT" | grep -q "Registration state: 'registered'"; then
            CURRENT="$(get_current_plmn)"

            if [ -z "$EXPECTED" ] || [ "$CURRENT" = "$EXPECTED" ]; then
                echo
                echo "Registration completed."
                [ -n "$CURRENT" ] &&
                    echo "Network: $(plmn_name "$CURRENT") ($CURRENT)"
                return 0
            fi
        fi

        COUNT=$((COUNT + 1))
        echo "  waiting... $((COUNT * WAIT_INTERVAL))s"
        sleep "$WAIT_INTERVAL"
    done

    echo
    echo "WARNING: expected registration did not occur after $((WAIT_MAX * WAIT_INTERVAL)) seconds."
    return 1
}

check_5g_nsa_ready() {
    SYS="$(qmi --nas-get-system-info 2>/dev/null)"
    SIG="$(qmi --nas-get-signal-info 2>/dev/null)"

    NSA="$(echo "$SYS" |
        awk -F"'" '/5G NSA Available:/ {print $2; exit}')"

    NR_RSRP="$(echo "$SIG" |
        awk "/5G:/,/^$/" |
        awk -F"'" '/RSRP:/ {print $2; exit}')"

    NR_SNR="$(echo "$SIG" |
        awk "/5G:/,/^$/" |
        awk -F"'" '/SNR:/ {print $2; exit}')"

    NR_RSRQ="$(echo "$SIG" |
        awk "/5G:/,/^$/" |
        awk -F"'" '/RSRQ:/ {print $2; exit}')"

    if [ "$NSA" = "yes" ] &&
       [ -n "$NR_RSRP" ] &&
       [ "$NR_RSRP" != "n/a" ]; then
        echo "5G NSA already active."
        echo "  RSRP: $NR_RSRP"
        [ -n "$NR_SNR" ]  && echo "  SNR:  $NR_SNR"
        [ -n "$NR_RSRQ" ] && echo "  RSRQ: $NR_RSRQ"
        return 0
    fi

    return 1
}

wait_5g_nsa() {
    ELAPSED=0

    echo
    echo "Waiting for 5G NSA..."

    while [ "$ELAPSED" -lt "$NSA_WAIT_MAX" ]; do
        SYS="$(qmi --nas-get-system-info 2>/dev/null)"
        SIG="$(qmi --nas-get-signal-info 2>/dev/null)"

        NSA="$(echo "$SYS" |
            awk -F"'" '/5G NSA Available:/ {print $2; exit}')"

        NR_RSRP="$(echo "$SIG" |
            awk "/5G:/,/^$/" |
            awk -F"'" '/RSRP:/ {print $2; exit}')"

        NR_SNR="$(echo "$SIG" |
            awk "/5G:/,/^$/" |
            awk -F"'" '/SNR:/ {print $2; exit}')"

        NR_RSRQ="$(echo "$SIG" |
            awk "/5G:/,/^$/" |
            awk -F"'" '/RSRQ:/ {print $2; exit}')"

        if [ "$NSA" = "yes" ] &&
           [ -n "$NR_RSRP" ] &&
           [ "$NR_RSRP" != "n/a" ]; then

            echo "5G NSA detected."
            echo "  RSRP: $NR_RSRP"
            [ -n "$NR_SNR" ]  && echo "  SNR:  $NR_SNR"
            [ -n "$NR_RSRQ" ] && echo "  RSRQ: $NR_RSRQ"

            echo "Waiting ${NSA_STABILIZE}s for NSA/CA stabilization..."
            sleep "$NSA_STABILIZE"
            return 0
        fi

        sleep "$NSA_WAIT_INTERVAL"
        ELAPSED=$((ELAPSED + NSA_WAIT_INTERVAL))
        echo "  waiting for 5G... ${ELAPSED}s"
    done

    echo
    echo "WARNING: 5G NSA did not become active within ${NSA_WAIT_MAX}s."
    echo "Continuing with LTE."
    return 1
}

set_manual_network() {
    NAME="$1"
    PLMN="$2"

    separator
    echo "Selecting $NAME"
    echo "PLMN: $PLMN"
    separator

    qmi --nas-set-system-selection-preference="manual=$PLMN"
    RC=$?

    [ "$RC" -eq 0 ] ||
        die "Failed to request selection of $NAME."

    wait_registration "$PLMN"
    RC=$?

    echo

    if [ "$RC" -ne 0 ]; then
        echo "Current state:"
        qmi --nas-get-serving-system
        return 1
    fi

    wait_5g_nsa || true

    echo
    short_status
    return 0
}

set_auto() {
    separator
    echo "Selecting carrier automatically"
    separator

    qmi --nas-set-system-selection-preference="automatic"
    RC=$?

    [ "$RC" -eq 0 ] ||
        die "Failed to enable automatic network selection."

    wait_registration ""
    RC=$?

    if [ "$RC" -eq 0 ]; then
        wait_5g_nsa || true
    fi

    echo
    short_status
}

short_status() {
    OUT="$(get_serving)"

    REG="$(echo "$OUT" |
        awk -F"'" '/Registration state:/ {print $2; exit}')"

    ROAM="$(echo "$OUT" |
        awk -F"'" '/Roaming status:/ {print $2; exit}')"

    RAT="$(echo "$OUT" |
        awk "/Radio interfaces:/,/Roaming status:/" |
        awk -F"'" '/\[0\]:/ {print $2; exit}')"

    PLMN="$(get_current_plmn)"
    NAME="$(plmn_name "$PLMN")"

    echo "Current network"
    separator

    printf "%-18s %s\n" "Registration:" "${REG:-unknown}"
    printf "%-18s %s\n" "Carrier:" "$NAME"
    printf "%-18s %s\n" "PLMN:" "${PLMN:-unknown}"
    printf "%-18s %s\n" "Primary RAT:" "${RAT:-unknown}"
    printf "%-18s %s\n" "Roaming:" "${ROAM:-unknown}"
}

signal_status() {
    separator
    echo "RADIO SIGNAL"
    separator
    qmi --nas-get-signal-info
}

cell_status() {
    separator
    echo "CELL / FREQUENCIES"
    separator
    qmi --nas-get-cell-location-info
}

radio_status() {
    separator
    echo "LTE / 5G SERVICES"
    separator
    qmi --nas-get-system-info
}

rf_status() {
    separator
    echo "RF / BANDS / CARRIER AGGREGATION"
    separator

    echo
    echo "[RF BAND INFO]"
    qmi --nas-get-rf-band-info 2>&1 || true

    echo
    echo "[LTE CPHY CA INFO]"
    qmi --nas-get-lte-cphy-ca-info 2>&1 || true

    echo
    echo "[CELL LOCATION INFO]"
    qmi --nas-get-cell-location-info 2>&1 || true

    echo
    echo "[SIGNAL INFO]"
    qmi --nas-get-signal-info 2>&1 || true
}

preferences() {
    separator
    echo "MODEM PREFERENCES"
    separator
    qmi --nas-get-system-selection-preference
}

scan_networks() {
    separator
    echo "CARRIER SCAN"
    echo "This may take some time..."
    separator
    qmi --nas-network-scan
}

full_status() {
    short_status

    echo
    separator
    echo "SIGNAL"
    separator
    qmi --nas-get-signal-info

    echo
    separator
    echo "LTE / 5G"
    separator
    qmi --nas-get-system-info

    echo
    separator
    echo "CELL"
    separator
    qmi --nas-get-cell-location-info

    echo
    rf_status
}

snapshot() {
    LABEL="$1"
    [ -z "$LABEL" ] && LABEL="snapshot"

    NOW="$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null)"
    PLMN="$(get_current_plmn)"
    NAME="$(plmn_name "$PLMN")"

    echo
    separator
    echo "SNAPSHOT: $LABEL"
    echo "Date: $NOW"
    echo "Carrier: $NAME"
    echo "PLMN: $PLMN"
    separator

    echo
    echo "[SERVING SYSTEM]"
    get_serving |
        grep -E \
        "Registration state:|Radio interfaces:|\[0\]:|Roaming status:|MCC:|MNC:|Description:|LTE tracking area code:|3GPP cell ID:"

    echo
    echo "[SIGNAL]"
    qmi --nas-get-signal-info

    echo
    echo "[SYSTEM]"
    qmi --nas-get-system-info |
        grep -E \
        "LTE service:|5G NSA Available:|DCNR Restriction:|5G SA service:|Status:|True Status:|MCC:|MNC:|Tracking Area Code:"

    echo
    echo "[CELL]"
    CELL="$(qmi --nas-get-cell-location-info 2>&1)"
    RC=$?

    if [ "$RC" -eq 0 ]; then
        echo "$CELL" |
            grep -E \
            "PLMN:|Tracking Area Code:|Global Cell ID:|EUTRA Absolute|Serving Cell ID:|5GNR ARFCN:"
    else
        echo "Unable to obtain Cell Location Info:"
        echo "$CELL"
    fi

    echo
    echo "[RF / CA]"
    qmi --nas-get-rf-band-info 2>&1 || true
    qmi --nas-get-lte-cphy-ca-info 2>&1 || true
}

compare_networks() {
    echo
    echo "============================================================"
    echo " TIM x VIVO RF COMPARISON"
    echo "============================================================"
    echo
    echo "The script will switch between both networks."
    echo "Does not change RAT or bands."
    echo "Waits for registration + 5G NSA attempt before the snapshot."
    echo

    echo "===== TIM ====="
    if set_manual_network "TIM" "$TIM_PLMN"; then
        echo
        snapshot "TIM"
    else
        echo "Failed to register on TIM."
    fi

    echo
    echo "===== VIVO ====="
    if set_manual_network "VIVO" "$VIVO_PLMN"; then
        echo
        snapshot "VIVO"
    else
        echo "Failed to register on VIVO."
    fi

    echo
    separator
    echo "Comparison completed."
    separator
    echo
    echo "The modem will remain on VIVO."
}

validate_duration() {
    case "$1" in
        ''|*[!0-9]*)
            die "Invalid duration: '$1'. Use whole seconds, e.g. 10."
            ;;
        0)
            die "Duration must be greater than zero."
            ;;
    esac
}

get_signal_compact() {
    SIG="$(qmi --nas-get-signal-info 2>/dev/null)"

    LTE_RSRP="$(echo "$SIG" |
        awk "/LTE:/,/^$/" |
        awk -F"'" '/RSRP:/ {print $2; exit}')"

    LTE_SNR="$(echo "$SIG" |
        awk "/LTE:/,/^$/" |
        awk -F"'" '/SNR:/ {print $2; exit}')"

    LTE_RSRQ="$(echo "$SIG" |
        awk "/LTE:/,/^$/" |
        awk -F"'" '/RSRQ:/ {print $2; exit}')"

    NR_RSRP="$(echo "$SIG" |
        awk "/5G:/,/^$/" |
        awk -F"'" '/RSRP:/ {print $2; exit}')"

    NR_SNR="$(echo "$SIG" |
        awk "/5G:/,/^$/" |
        awk -F"'" '/SNR:/ {print $2; exit}')"

    NR_RSRQ="$(echo "$SIG" |
        awk "/5G:/,/^$/" |
        awk -F"'" '/RSRQ:/ {print $2; exit}')"

    printf "%s|%s|%s|%s|%s|%s\n" \
        "${LTE_RSRP:-n/a}" "${LTE_SNR:-n/a}" "${LTE_RSRQ:-n/a}" \
        "${NR_RSRP:-n/a}" "${NR_SNR:-n/a}" "${NR_RSRQ:-n/a}"
}

speedtest_server_arg() {
    MODE="$1"
    case "$MODE" in
        fixed)
            echo "$SPEEDTEST_SERVER"
            ;;
        auto|"")
            echo ""
            ;;
        *)
            echo ""
            ;;
    esac
}

speedtest_mode_label() {
    MODE="$1"
    case "$MODE" in
        fixed) echo "fixed: $SPEEDTEST_SERVER" ;;
        *) echo "automatic" ;;
    esac
}

run_ui_speed() {
    DURATION="$1"
    MODE="${2:-$SPEEDTEST_MODE_DEFAULT}"
    SERVER_ARG="$(speedtest_server_arg "$MODE")"

    if [ -n "$SERVER_ARG" ]; then
        ui-speed test \
            --intf "$WWAN_IF" \
            -d both \
            --durMax "$DURATION" \
            -o json \
            "$SERVER_ARG" 2>&1
    else
        ui-speed test \
            --intf "$WWAN_IF" \
            -d both \
            --durMax "$DURATION" \
            -o json 2>&1
    fi
}

get_ca_sample() {
    CA="$(qmi --nas-get-lte-cphy-ca-info 2>/dev/null)"

    ACTIVE="$(echo "$CA" | grep -c "State: 'activated'" 2>/dev/null)"
    [ -z "$ACTIVE" ] && ACTIVE=0

    TOTAL="$(echo "$CA" | grep -c "Secondary Cell [0-9].*Info" 2>/dev/null)"
    [ -z "$TOTAL" ] && TOTAL=0

    PRIMARY="$(echo "$CA" | awk -F"'" '/Primary Cell Info/{p=1;next} p && /LTE Band:/{print $2; exit}')"

    SCELLS="$(echo "$CA" | awk -F"'" '
        /Secondary Cell [0-9]+ Info/ { sec=1; band=""; ch=""; bw=""; state=""; next }
        sec && /RX Channel:/ { ch=$2 }
        sec && /DL Bandwidth:/ { bw=$2 }
        sec && /LTE Band:/ { band=$2 }
        sec && /State:/ {
            state=$2
            if (out != "") out=out ","
            out=out band "@" ch "/" bw "MHz:" state
            sec=0
        }
        END { print out }
    ')"

    printf "%s|%s|%s|%s\n" "${ACTIVE:-0}" "${TOTAL:-0}" "${PRIMARY:-n/a}" "${SCELLS:-n/a}"
}

quoted_field() {
    PATTERN="$1"
    awk -F"'" -v pattern="$PATTERN" \
        '$0 ~ pattern { print $2; exit }'
}

metric_number() {
    awk '{
        value=$1
        if (value ~ /^-?[0-9]+([.][0-9]+)?$/) {
            print value
            found=1
            exit
        }
    }
    END { if (!found) print "n/a" }'
}

record_field() {
    FIELD_NUMBER="$1"
    awk -F'|' -v field_number="$FIELD_NUMBER" \
        '{ print $field_number }'
}

collect_radio_sample() {
    SERVING="$(get_serving)"
    SIGNAL="$(qmi --nas-get-signal-info 2>/dev/null || true)"
    SYSTEM="$(qmi --nas-get-system-info 2>/dev/null || true)"
    CELL_INFO="$(qmi --nas-get-cell-location-info 2>/dev/null || true)"
    RF_INFO="$(qmi --nas-get-rf-band-info 2>/dev/null || true)"
    CA_INFO="$(qmi --nas-get-lte-cphy-ca-info 2>/dev/null || true)"

    REGISTRATION="$(echo "$SERVING" | quoted_field 'Registration state:')"
    SAMPLE_RAT="$(echo "$SERVING" |
        awk '/Radio interfaces:/,/Roaming status:/' |
        awk -F"'" '/\[0\]:/ {print $2; exit}')"
    MCC="$(echo "$SERVING" | awk '/Current PLMN:/,/Roaming indicators:/' | quoted_field 'MCC:')"
    MNC="$(echo "$SERVING" | awk '/Current PLMN:/,/Roaming indicators:/' | quoted_field 'MNC:')"
    if [ -n "$MNC" ]; then
        case "$MNC" in
            [0-9]) MNC="0$MNC" ;;
        esac
    fi
    if [ -n "$MCC" ] && [ -n "$MNC" ]; then
        SAMPLE_PLMN="${MCC}${MNC}"
    else
        SAMPLE_PLMN="n/a"
    fi
    CARRIER="$(plmn_name "$SAMPLE_PLMN")"

    TAC="n/a"
    ECI="n/a"
    ENODEB="n/a"
    SECTOR="n/a"
    LTE_PCI="n/a"
    LTE_EARFCN="n/a"
    LTE_BAND="n/a"
    LTE_BANDWIDTH="n/a"

    if [ "$SAMPLE_RAT" = "lte" ]; then
        TAC="$(echo "$CELL_INFO" | quoted_field 'Tracking Area Code:')"
        [ -n "$TAC" ] || TAC="$(echo "$SERVING" | quoted_field 'LTE tracking area code:')"
        ECI="$(echo "$CELL_INFO" | quoted_field 'Global Cell ID:')"
        [ -n "$ECI" ] || ECI="$(echo "$SERVING" | quoted_field '3GPP cell ID:')"

        case "$ECI" in
            ''|*[!0-9]*) ;;
            *)
                ECI_PARTS="$(awk -v eci="$ECI" 'BEGIN {
                    enodeb=int(eci / 256)
                    sector=eci - (enodeb * 256)
                    printf "%.0f|%.0f\n", enodeb, sector
                }')"
                ENODEB="$(echo "$ECI_PARTS" | record_field 1)"
                SECTOR="$(echo "$ECI_PARTS" | record_field 2)"
                ;;
        esac

        LTE_PCI="$(echo "$CA_INFO" | awk -F"'" '/Primary Cell Info/{p=1;next} p && /Physical Cell ID:/{print $2; exit}')"
        [ -n "$LTE_PCI" ] || LTE_PCI="$(echo "$CELL_INFO" | quoted_field 'Serving Cell ID:')"
        LTE_EARFCN="$(echo "$CELL_INFO" | quoted_field 'EUTRA Absolute RF Channel Number:')"
        LTE_BAND="$(echo "$CA_INFO" | awk -F"'" '/Primary Cell Info/{p=1;next} p && /LTE Band:/{print $2; exit}')"
        [ -n "$LTE_BAND" ] || LTE_BAND="$(echo "$RF_INFO" | awk -F"'" '/Radio Interface:.*lte/{lte=1;next} lte && /Active Band Class:/{print $2; exit}')"
        LTE_BANDWIDTH="$(echo "$CA_INFO" | awk -F"'" '/Primary Cell Info/{p=1;next} p && /DL Bandwidth:/{print $2; exit}')"
    fi

    LTE_RSRP="$(echo "$SIGNAL" | awk '/LTE:/,/^$/' | quoted_field 'RSRP:' | metric_number)"
    LTE_RSRQ="$(echo "$SIGNAL" | awk '/LTE:/,/^$/' | quoted_field 'RSRQ:' | metric_number)"
    LTE_SNR="$(echo "$SIGNAL" | awk '/LTE:/,/^$/' | quoted_field 'SNR:' | metric_number)"
    NR_RSRP="$(echo "$SIGNAL" | awk '/5G:/,/^$/' | quoted_field 'RSRP:' | metric_number)"
    NR_RSRQ="$(echo "$SIGNAL" | awk '/5G:/,/^$/' | quoted_field 'RSRQ:' | metric_number)"
    NR_SNR="$(echo "$SIGNAL" | awk '/5G:/,/^$/' | quoted_field 'SNR:' | metric_number)"

    NR_ARFCN="$(echo "$CELL_INFO" | quoted_field '5GNR ARFCN:')"
    NR_BAND="$(echo "$CELL_INFO" | quoted_field '5GNR Band:')"
    NR_PCI="$(echo "$CELL_INFO" | quoted_field '5GNR Physical Cell ID:')"
    NR_NCI="$(echo "$CELL_INFO" | quoted_field '5GNR Global Cell ID:')"
    NSA_STATUS="$(echo "$SYSTEM" | quoted_field '5G NSA Available:')"

    CA_ACTIVE="$(echo "$CA_INFO" | grep -c "State: 'activated'" 2>/dev/null)"
    CA_PRIMARY="$(echo "$CA_INFO" | awk -F"'" '/Primary Cell Info/{p=1;next} p && /LTE Band:/{band=$2} p && /RX Channel:/{channel=$2} p && band!="" && channel!="" {print band "@" channel; exit}')"
    CA_SCELLS="$(echo "$CA_INFO" | awk -F"'" '
        /Secondary Cell [0-9]+ Info/ { sec=1; band=""; channel=""; state=""; next }
        sec && /LTE Band:/ { band=$2 }
        sec && /RX Channel:/ { channel=$2 }
        sec && /State:/ {
            state=$2
            if (out != "") out=out ","
            out=out band "@" channel ":" state
            sec=0
        }
        END { print out }
    ')"

    printf '%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s\n' \
        "${SAMPLE_PLMN:-n/a}" "${CARRIER:-UNKNOWN}" "${MCC:-n/a}" "${MNC:-n/a}" \
        "${REGISTRATION:-n/a}" "${TAC:-n/a}" "${ECI:-n/a}" "$ENODEB" "$SECTOR" \
        "${LTE_PCI:-n/a}" "${LTE_EARFCN:-n/a}" "${LTE_BAND:-n/a}" "${LTE_BANDWIDTH:-n/a}" \
        "$LTE_RSRP" "$LTE_RSRQ" "$LTE_SNR" "${NR_ARFCN:-n/a}" "${NR_BAND:-n/a}" \
        "${NR_PCI:-n/a}" "${NR_NCI:-n/a}" "$NR_RSRP" "$NR_RSRQ" "$NR_SNR" \
        "${NSA_STATUS:-n/a}" "${CA_ACTIVE:-0}" "${CA_PRIMARY:-n/a}" "${CA_SCELLS:-n/a}" \
        "${SAMPLE_RAT:-n/a}"
}

cells_summary() {
    SAMPLE="$(collect_radio_sample)"

    separator
    echo "SERVING CELL INTELLIGENCE"
    separator
    printf '%-24s %s\n' "Carrier:" "$(echo "$SAMPLE" | record_field 2)"
    printf '%-24s %s\n' "PLMN:" "$(echo "$SAMPLE" | record_field 1)"
    printf '%-24s %s\n' "MCC:" "$(echo "$SAMPLE" | record_field 3)"
    printf '%-24s %s\n' "MNC:" "$(echo "$SAMPLE" | record_field 4)"
    printf '%-24s %s\n' "Registration:" "$(echo "$SAMPLE" | record_field 5)"
    printf '%-24s %s\n' "Primary RAT:" "$(echo "$SAMPLE" | record_field 28)"
    printf '%-24s %s\n' "LTE TAC:" "$(echo "$SAMPLE" | record_field 6)"
    printf '%-24s %s\n' "LTE ECI / Cell ID:" "$(echo "$SAMPLE" | record_field 7)"
    printf '%-24s %s\n' "LTE eNodeB ID:*" "$(echo "$SAMPLE" | record_field 8)"
    printf '%-24s %s\n' "LTE sector ID:*" "$(echo "$SAMPLE" | record_field 9)"
    printf '%-24s %s\n' "LTE PCI:" "$(echo "$SAMPLE" | record_field 10)"
    printf '%-24s %s\n' "LTE EARFCN:" "$(echo "$SAMPLE" | record_field 11)"
    printf '%-24s %s\n' "LTE band:" "$(echo "$SAMPLE" | record_field 12)"
    printf '%-24s %s\n' "LTE bandwidth:" "$(echo "$SAMPLE" | record_field 13)"
    printf '%-24s %s dBm\n' "LTE RSRP:" "$(echo "$SAMPLE" | record_field 14)"
    printf '%-24s %s dB\n' "LTE RSRQ:" "$(echo "$SAMPLE" | record_field 15)"
    printf '%-24s %s dB\n' "LTE SNR:" "$(echo "$SAMPLE" | record_field 16)"
    printf '%-24s %s\n' "NR ARFCN:" "$(echo "$SAMPLE" | record_field 17)"
    printf '%-24s %s\n' "NR band:" "$(echo "$SAMPLE" | record_field 18)"
    printf '%-24s %s\n' "NR PCI:" "$(echo "$SAMPLE" | record_field 19)"
    printf '%-24s %s\n' "NR NCI / Cell ID:" "$(echo "$SAMPLE" | record_field 20)"
    printf '%-24s %s dBm\n' "NR RSRP:" "$(echo "$SAMPLE" | record_field 21)"
    printf '%-24s %s dB\n' "NR RSRQ:" "$(echo "$SAMPLE" | record_field 22)"
    printf '%-24s %s dB\n' "NR SNR:" "$(echo "$SAMPLE" | record_field 23)"
    printf '%-24s %s\n' "5G NSA available:" "$(echo "$SAMPLE" | record_field 24)"
    printf '%-24s %s\n' "Active LTE SCells:" "$(echo "$SAMPLE" | record_field 25)"
    printf '%-24s %s\n' "Primary LTE carrier:" "$(echo "$SAMPLE" | record_field 26)"
    printf '%-24s %s\n' "Observed LTE SCells:" "$(echo "$SAMPLE" | record_field 27)"
    echo
    echo "* Calculated from a decimal ECI using the common LTE layout"
    echo "  (eNodeB = ECI >> 8, sector = ECI & 255); operator layouts may differ."
    if [ "$(echo "$SAMPLE" | record_field 28)" != "lte" ]; then
        echo "  LTE identifiers are n/a because the serving RAT is not LTE."
    fi
}

tower_id() {
    SAMPLE="$(collect_radio_sample)"
    PLMN="$(echo "$SAMPLE" | record_field 1)"
    TAC="$(echo "$SAMPLE" | record_field 6)"
    ECI="$(echo "$SAMPLE" | record_field 7)"
    ENODEB="$(echo "$SAMPLE" | record_field 8)"
    SECTOR="$(echo "$SAMPLE" | record_field 9)"
    LTE_PCI="$(echo "$SAMPLE" | record_field 10)"
    LTE_EARFCN="$(echo "$SAMPLE" | record_field 11)"
    LTE_BAND="$(echo "$SAMPLE" | record_field 12)"
    NR_ARFCN="$(echo "$SAMPLE" | record_field 17)"
    NR_PCI="$(echo "$SAMPLE" | record_field 19)"
    NR_NCI="$(echo "$SAMPLE" | record_field 20)"
    SAMPLE_RAT="$(echo "$SAMPLE" | record_field 28)"

    separator
    echo "TOWER LOOKUP IDENTIFIERS"
    separator
    printf '%-18s %s\n' "PLMN:" "$PLMN"
    printf '%-18s %s\n' "Primary RAT:" "$SAMPLE_RAT"
    printf '%-18s %s\n' "TAC:" "$TAC"
    printf '%-18s %s\n' "ECI / Cell ID:" "$ECI"
    printf '%-18s %s\n' "eNodeB ID:*" "$ENODEB"
    printf '%-18s %s\n' "Sector ID:*" "$SECTOR"
    printf '%-18s %s\n' "LTE PCI:" "$LTE_PCI"
    printf '%-18s %s\n' "LTE EARFCN:" "$LTE_EARFCN"
    printf '%-18s %s\n' "LTE band:" "$LTE_BAND"
    printf '%-18s %s\n' "NR ARFCN:" "$NR_ARFCN"
    printf '%-18s %s\n' "NR PCI:" "$NR_PCI"
    printf '%-18s %s\n' "NR NCI / Cell ID:" "$NR_NCI"
    echo
    echo "Fingerprint: $PLMN TAC=$TAC ECI=$ECI eNB=$ENODEB sector=$SECTOR PCI=$LTE_PCI EARFCN=$LTE_EARFCN NR-ARFCN=$NR_ARFCN"
    echo
    echo "* Calculated from a decimal ECI using the common LTE layout; operator layouts may differ."
    [ "$SAMPLE_RAT" = "lte" ] || echo "LTE identifiers are n/a because the serving RAT is not LTE."
    echo "No external database or Internet lookup was performed."
}

neighbors() {
    separator
    echo "NEIGHBORING CELL INFORMATION"
    separator
    echo "Read-only QMI cell-location response."
    echo "Fields depend on modem firmware and serving RAT."
    echo
    qmi --nas-get-cell-location-info 2>&1 ||
        die "Unable to obtain neighboring cell information."
}

tower_export() {
    FORMAT="${1:-json}"
    SAMPLE="$(collect_radio_sample)"

    case "$FORMAT" in
        json)
            printf '{\n'
            printf '  "plmn": "%s",\n' "$(echo "$SAMPLE" | record_field 1)"
            printf '  "carrier": "%s",\n' "$(echo "$SAMPLE" | record_field 2)"
            printf '  "mcc": "%s",\n' "$(echo "$SAMPLE" | record_field 3)"
            printf '  "mnc": "%s",\n' "$(echo "$SAMPLE" | record_field 4)"
            printf '  "rat": "%s",\n' "$(echo "$SAMPLE" | record_field 28)"
            printf '  "tac": "%s",\n' "$(echo "$SAMPLE" | record_field 6)"
            printf '  "eci": "%s",\n' "$(echo "$SAMPLE" | record_field 7)"
            printf '  "enodeb": "%s",\n' "$(echo "$SAMPLE" | record_field 8)"
            printf '  "sector": "%s",\n' "$(echo "$SAMPLE" | record_field 9)"
            printf '  "lte_pci": "%s",\n' "$(echo "$SAMPLE" | record_field 10)"
            printf '  "lte_earfcn": "%s",\n' "$(echo "$SAMPLE" | record_field 11)"
            printf '  "lte_band": "%s",\n' "$(echo "$SAMPLE" | record_field 12)"
            printf '  "nr_arfcn": "%s",\n' "$(echo "$SAMPLE" | record_field 17)"
            printf '  "nr_pci": "%s",\n' "$(echo "$SAMPLE" | record_field 19)"
            printf '  "nr_nci": "%s"\n' "$(echo "$SAMPLE" | record_field 20)"
            printf '}\n'
            ;;
        csv)
            echo "plmn,carrier,mcc,mnc,rat,tac,eci,enodeb,sector,lte_pci,lte_earfcn,lte_band,nr_arfcn,nr_pci,nr_nci"
            printf '%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s\n' \
                "$(echo "$SAMPLE" | record_field 1)" "$(echo "$SAMPLE" | record_field 2)" \
                "$(echo "$SAMPLE" | record_field 3)" "$(echo "$SAMPLE" | record_field 4)" \
                "$(echo "$SAMPLE" | record_field 28)" "$(echo "$SAMPLE" | record_field 6)" \
                "$(echo "$SAMPLE" | record_field 7)" "$(echo "$SAMPLE" | record_field 8)" \
                "$(echo "$SAMPLE" | record_field 9)" "$(echo "$SAMPLE" | record_field 10)" \
                "$(echo "$SAMPLE" | record_field 11)" "$(echo "$SAMPLE" | record_field 12)" \
                "$(echo "$SAMPLE" | record_field 17)" "$(echo "$SAMPLE" | record_field 19)" \
                "$(echo "$SAMPLE" | record_field 20)"
            ;;
        *) die "Unsupported export format: $FORMAT (use json or csv)." ;;
    esac
}

validate_coordinate() {
    VALUE="$1"
    MINIMUM="$2"
    MAXIMUM="$3"
    LABEL="$4"
    awk -v value="$VALUE" -v minimum="$MINIMUM" -v maximum="$MAXIMUM" \
        'BEGIN { exit !(value ~ /^-?[0-9]+([.][0-9]+)?$/ && value >= minimum && value <= maximum) }' ||
        die "Invalid $LABEL: $VALUE"
}

json_number() {
    echo "$1" | tr -d '\r\n' |
        sed -n "s/.*\"$2\"[[:space:]]*:[[:space:]]*\([-0-9.][0-9.]*\).*/\1/p"
}

json_boolean() {
    echo "$1" | tr -d '\r\n' |
        sed -n "s/.*\"$2\"[[:space:]]*:[[:space:]]*\(true\|false\).*/\1/p"
}

opencellid_error() {
    RESPONSE_TEXT="$(echo "$1" | tr '\r\n' '  ')"
    ERROR_TEXT="$(echo "$RESPONSE_TEXT" |
        sed -n 's/.*"error"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
    [ -n "$ERROR_TEXT" ] || ERROR_TEXT="$(echo "$RESPONSE_TEXT" |
        sed -n 's/.*"message"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
    [ -n "$ERROR_TEXT" ] || ERROR_TEXT="$(echo "$RESPONSE_TEXT" |
        sed -n 's/.*info="\([^"]*\)".*/\1/p')"
    echo "${ERROR_TEXT:-unrecognized provider response}"
}

opencellid_request() {
    API_KEY="${OPENCELLID_API_KEY:-}"
    [ -n "$API_KEY" ] || die "OPENCELLID_API_KEY is not set."
    case "$API_KEY" in *[!A-Za-z0-9._-]*) die "OPENCELLID_API_KEY contains unsupported characters." ;; esac

    if command -v curl >/dev/null 2>&1; then
        {
            printf 'url = "%s"\n' "$OPENCELLID_ENDPOINT"
            echo 'get'
            printf 'data-urlencode = "key=%s"\n' "$API_KEY"
            printf 'data-urlencode = "mcc=%s"\n' "$1"
            printf 'data-urlencode = "mnc=%s"\n' "$2"
            printf 'data-urlencode = "lac=%s"\n' "$3"
            printf 'data-urlencode = "cellid=%s"\n' "$4"
            printf 'data-urlencode = "radio=%s"\n' "$5"
            echo 'data-urlencode = "format=json"'
        } | curl -sS --connect-timeout 10 --max-time 30 -K -
    elif command -v wget >/dev/null 2>&1; then
        URL="$OPENCELLID_ENDPOINT?key=$API_KEY&mcc=$1&mnc=$2&lac=$3&cellid=$4&radio=$5&format=json"
        wget -q -T 30 -O - "$URL"
    else
        die "OpenCellID lookup requires curl or wget."
    fi
}

location_metrics() {
    DEVICE_LAT="$1" DEVICE_LON="$2" TOWER_LAT="$3" TOWER_LON="$4"
    awk -v lat1="$DEVICE_LAT" -v lon1="$DEVICE_LON" -v lat2="$TOWER_LAT" -v lon2="$TOWER_LON" 'BEGIN {
        pi=atan2(0,-1); r=6371; p1=lat1*pi/180; p2=lat2*pi/180
        dp=(lat2-lat1)*pi/180; dl=(lon2-lon1)*pi/180
        a=sin(dp/2)^2 + cos(p1)*cos(p2)*sin(dl/2)^2
        distance=2*r*atan2(sqrt(a),sqrt(1-a))
        y=sin(dl)*cos(p2); x=cos(p1)*sin(p2)-sin(p1)*cos(p2)*cos(dl)
        bearing=atan2(y,x)*180/pi; if (bearing < 0) bearing+=360
        printf "%.2f|%.1f\n", distance, bearing
    }'
}

tower_lookup() {
    DEVICE_LAT="${1:-${CELLNET_LATITUDE:-}}"
    DEVICE_LON="${2:-${CELLNET_LONGITUDE:-}}"
    if [ -z "$DEVICE_LAT" ] || [ -z "$DEVICE_LON" ]; then
        die "Provide device latitude and longitude or set CELLNET_LATITUDE and CELLNET_LONGITUDE."
    fi
    validate_coordinate "$DEVICE_LAT" -90 90 "latitude"
    validate_coordinate "$DEVICE_LON" -180 180 "longitude"

    SAMPLE="$(collect_radio_sample)"
    MCC="$(echo "$SAMPLE" | record_field 3)"
    MNC="$(echo "$SAMPLE" | record_field 4)"
    TAC="$(echo "$SAMPLE" | record_field 6)"
    CELL_ID="$(echo "$SAMPLE" | record_field 7)"
    RAT="$(echo "$SAMPLE" | record_field 28)"
    [ "$RAT" = "lte" ] || die "OpenCellID lookup currently requires an LTE serving cell."
    for VALUE in "$MCC" "$MNC" "$TAC" "$CELL_ID"; do
        case "$VALUE" in ''|n/a|*[!0-9]*) die "Serving-cell identifiers are incomplete." ;; esac
    done

    RESPONSE="$(opencellid_request "$MCC" "$MNC" "$TAC" "$CELL_ID" LTE)" ||
        die "OpenCellID lookup failed."
    TOWER_LAT="$(json_number "$RESPONSE" lat)"
    TOWER_LON="$(json_number "$RESPONSE" lon)"
    RANGE="$(json_number "$RESPONSE" range)"
    SAMPLES="$(json_number "$RESPONSE" samples)"
    CHANGEABLE="$(json_boolean "$RESPONSE" changeable)"
    if [ -z "$TOWER_LAT" ] || [ -z "$TOWER_LON" ]; then
        PROVIDER_ERROR="$(opencellid_error "$RESPONSE")"
        echo "ERROR: OpenCellID returned no usable coordinates: $PROVIDER_ERROR" >&2
        return 3
    fi

    METRICS="$(location_metrics "$DEVICE_LAT" "$DEVICE_LON" "$TOWER_LAT" "$TOWER_LON")"
    DISTANCE="$(echo "$METRICS" | record_field 1)"
    BEARING="$(echo "$METRICS" | record_field 2)"
    CONFIDENCE="low"
    case "${SAMPLES:-0}:${RANGE:-999999}" in
        [1-9][0-9]*:[0-9]|[1-9][0-9]*:[0-9][0-9]|[1-9][0-9]*:[0-9][0-9][0-9]) CONFIDENCE="high" ;;
        [3-9]:*|[1-9][0-9]*:*) CONFIDENCE="medium" ;;
    esac

    separator
    echo "OPENCELLID TOWER LOOKUP"
    separator
    printf '%-24s %s\n' "Cell:" "$MCC-$MNC TAC=$TAC ECI=$CELL_ID"
    printf '%-24s %s, %s\n' "Device coordinates:" "$DEVICE_LAT" "$DEVICE_LON"
    printf '%-24s %s, %s\n' "Tower coordinates:" "$TOWER_LAT" "$TOWER_LON"
    printf '%-24s %s km\n' "Approximate distance:" "$DISTANCE"
    printf '%-24s %s degrees\n' "Initial bearing:" "$BEARING"
    printf '%-24s %s m\n' "Reported range:" "${RANGE:-n/a}"
    printf '%-24s %s\n' "OpenCellID samples:" "${SAMPLES:-n/a}"
    printf '%-24s %s\n' "Position calculated:" "${CHANGEABLE:-n/a}"
    printf '%-24s %s\n' "Correlation confidence:" "$CONFIDENCE"
    echo
    echo "Coordinates are provided by OpenCellID and are not a modem GNSS fix."
}

observe_cells() {
    DURATION="${1:-60}"
    validate_duration "$DURATION"
    echo "timestamp,plmn,rat,tac,eci,enodeb,sector,lte_pci,lte_earfcn,lte_rsrp,lte_rsrq,lte_snr,nr_arfcn,nr_pci,nr_rsrp,nr_rsrq,nr_snr"
    ELAPSED=0
    while [ "$ELAPSED" -lt "$DURATION" ]; do
        SAMPLE="$(collect_radio_sample)"
        printf '%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s\n' \
            "$(date '+%Y-%m-%dT%H:%M:%S%z' 2>/dev/null || echo n/a)" \
            "$(echo "$SAMPLE" | record_field 1)" "$(echo "$SAMPLE" | record_field 28)" \
            "$(echo "$SAMPLE" | record_field 6)" "$(echo "$SAMPLE" | record_field 7)" \
            "$(echo "$SAMPLE" | record_field 8)" "$(echo "$SAMPLE" | record_field 9)" \
            "$(echo "$SAMPLE" | record_field 10)" "$(echo "$SAMPLE" | record_field 11)" \
            "$(echo "$SAMPLE" | record_field 14)" "$(echo "$SAMPLE" | record_field 15)" \
            "$(echo "$SAMPLE" | record_field 16)" "$(echo "$SAMPLE" | record_field 17)" \
            "$(echo "$SAMPLE" | record_field 19)" "$(echo "$SAMPLE" | record_field 21)" \
            "$(echo "$SAMPLE" | record_field 22)" "$(echo "$SAMPLE" | record_field 23)"
        sleep "$RADIO_POLL_INTERVAL"
        ELAPSED=$((ELAPSED + RADIO_POLL_INTERVAL))
    done
}

tower_assess() {
    LATITUDE="$1"
    LONGITUDE="$2"
    DURATION="${3:-60}"
    tower_lookup "$LATITUDE" "$LONGITUDE" || return $?
    echo
    stability_summary "$DURATION"
    echo
    echo "Assessment combines OpenCellID proximity with local RF stability."
    echo "Use tower-assess-speed only when cellular data consumption is acceptable."
}

tower_assess_speed() {
    LATITUDE="$1"
    LONGITUDE="$2"
    DURATION="${3:-$SPEEDTEST_DURATION}"
    tower_lookup "$LATITUDE" "$LONGITUDE" || return $?
    echo
    stability_summary "$DURATION"
    echo
    speedtest_current "$DURATION"
}

report_sample_changes() {
    CURRENT="$1"
    PREVIOUS="$2"
    [ -n "$PREVIOUS" ] || return 0

    for CHANGE_SPEC in '1:PLMN' '10:LTE PCI' '11:LTE EARFCN' '7:LTE ECI' '17:NR ARFCN' '19:NR PCI'
    do
        FIELD="${CHANGE_SPEC%%:*}"
        LABEL="${CHANGE_SPEC#*:}"
        OLD="$(echo "$PREVIOUS" | record_field "$FIELD")"
        NEW="$(echo "$CURRENT" | record_field "$FIELD")"
        if [ "$OLD" != "$NEW" ]; then
            echo "CHANGE: $LABEL $OLD -> $NEW"
        fi
    done
}

watch_radio() {
    DURATION="${1:-60}"
    validate_duration "$DURATION"
    ELAPSED=0
    PREVIOUS=""

    trap 'echo; echo "Monitor stopped."; exit 0' INT TERM
    echo "Read-only radio monitor: ${DURATION}s, ${RADIO_POLL_INTERVAL}s interval"
    echo "Timestamp           PLMN   LTE RSRP RSRQ SNR PCI EARFCN | NR RSRP RSRQ SNR ARFCN | SCells"

    while [ "$ELAPSED" -lt "$DURATION" ]; do
        SAMPLE="$(collect_radio_sample)"
        NOW="$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null)"
        printf '%-19s %-6s %8s %4s %4s %3s %6s | %7s %4s %4s %6s | %s\n' \
            "$NOW" "$(echo "$SAMPLE" | record_field 1)" \
            "$(echo "$SAMPLE" | record_field 14)" "$(echo "$SAMPLE" | record_field 15)" \
            "$(echo "$SAMPLE" | record_field 16)" "$(echo "$SAMPLE" | record_field 10)" \
            "$(echo "$SAMPLE" | record_field 11)" "$(echo "$SAMPLE" | record_field 21)" \
            "$(echo "$SAMPLE" | record_field 22)" "$(echo "$SAMPLE" | record_field 23)" \
            "$(echo "$SAMPLE" | record_field 17)" "$(echo "$SAMPLE" | record_field 25)"
        report_sample_changes "$SAMPLE" "$PREVIOUS"
        PREVIOUS="$SAMPLE"
        ELAPSED=$((ELAPSED + RADIO_POLL_INTERVAL))
        [ "$ELAPSED" -ge "$DURATION" ] || sleep "$RADIO_POLL_INTERVAL"
    done
    trap - INT TERM
}

print_stability_metric() {
    LABEL="$1"
    FIELD="$2"
    awk -F'|' -v label="$LABEL" -v field="$FIELD" '
        $field ~ /^-?[0-9]+([.][0-9]+)?$/ {
            value=$field + 0
            if (count == 0 || value < min) min=value
            if (count == 0 || value > max) max=value
            sum+=value
            count++
        }
        END {
            printf "%-10s ", label ":"
            if (count == 0) print "n/a (no modem samples)"
            else printf "avg=%.2f min=%.2f max=%.2f range=%.2f samples=%d\n", sum/count, min, max, max-min, count
        }
    ' "$STABILITY_FILE"
}

stability_summary() {
    DURATION="${1:-60}"
    validate_duration "$DURATION"
    STABILITY_FILE="${TMPDIR:-/tmp}/cellnet-stability.$$"
    : > "$STABILITY_FILE" || die "Unable to create temporary sample file."
    trap 'rm -f "$STABILITY_FILE"; echo; echo "Stability sampling stopped."; exit 0' INT TERM
    ELAPSED=0
    SAMPLE_COUNT=0
    PLMN_CHANGES=0
    CELL_CHANGES=0
    PCI_CHANGES=0
    EARFCN_CHANGES=0
    NR_ARFCN_CHANGES=0
    MAX_SCELLS=0
    PREVIOUS=""

    echo "Collecting read-only RF samples for ${DURATION}s..."
    while [ "$ELAPSED" -lt "$DURATION" ]; do
        SAMPLE="$(collect_radio_sample)"
        echo "$SAMPLE" >> "$STABILITY_FILE"
        SAMPLE_COUNT=$((SAMPLE_COUNT + 1))
        ACTIVE_SCELLS="$(echo "$SAMPLE" | record_field 25)"
        case "$ACTIVE_SCELLS" in
            ''|*[!0-9]*) ;;
            *) [ "$ACTIVE_SCELLS" -le "$MAX_SCELLS" ] || MAX_SCELLS="$ACTIVE_SCELLS" ;;
        esac
        if [ -n "$PREVIOUS" ]; then
            [ "$(echo "$SAMPLE" | record_field 1)" = "$(echo "$PREVIOUS" | record_field 1)" ] || PLMN_CHANGES=$((PLMN_CHANGES + 1))
            [ "$(echo "$SAMPLE" | record_field 7)" = "$(echo "$PREVIOUS" | record_field 7)" ] || CELL_CHANGES=$((CELL_CHANGES + 1))
            [ "$(echo "$SAMPLE" | record_field 10)" = "$(echo "$PREVIOUS" | record_field 10)" ] || PCI_CHANGES=$((PCI_CHANGES + 1))
            [ "$(echo "$SAMPLE" | record_field 11)" = "$(echo "$PREVIOUS" | record_field 11)" ] || EARFCN_CHANGES=$((EARFCN_CHANGES + 1))
            [ "$(echo "$SAMPLE" | record_field 17)" = "$(echo "$PREVIOUS" | record_field 17)" ] || NR_ARFCN_CHANGES=$((NR_ARFCN_CHANGES + 1))
        fi
        PREVIOUS="$SAMPLE"
        ELAPSED=$((ELAPSED + RADIO_POLL_INTERVAL))
        [ "$ELAPSED" -ge "$DURATION" ] || sleep "$RADIO_POLL_INTERVAL"
    done

    echo
    separator
    echo "RF STABILITY SUMMARY"
    separator
    printf '%-24s %s\n' "Samples:" "$SAMPLE_COUNT"
    print_stability_metric "LTE RSRP" 14
    print_stability_metric "LTE RSRQ" 15
    print_stability_metric "LTE SNR" 16
    print_stability_metric "NR RSRP" 21
    print_stability_metric "NR RSRQ" 22
    print_stability_metric "NR SNR" 23
    printf '%-24s %s\n' "PLMN changes:" "$PLMN_CHANGES"
    printf '%-24s %s\n' "LTE cell changes:" "$CELL_CHANGES"
    printf '%-24s %s\n' "LTE PCI changes:" "$PCI_CHANGES"
    printf '%-24s %s\n' "LTE EARFCN changes:" "$EARFCN_CHANGES"
    printf '%-24s %s\n' "NR ARFCN changes:" "$NR_ARFCN_CHANGES"
    printf '%-24s %s\n' "Max active LTE SCells:" "$MAX_SCELLS"

    rm -f "$STABILITY_FILE"
    trap - INT TERM
}

get_speedtest_phase() {
    OUTFILE="$1"

    LAST_STATE="$(tail -n 40 "$OUTFILE" 2>/dev/null |
        grep -E '"state":[0-9]+' |
        tail -n 1 |
        sed -n 's/.*"state":\([0-9][0-9]*\).*/\1/p')"

    case "$LAST_STATE" in
        3) echo "down" ;;
        4) echo "up" ;;
        5|6|7) echo "done" ;;
        *) echo "setup" ;;
    esac
}

monitor_rf_ca() {
    PID="$1"
    OUTFILE="$2"
    LOG="$3"
    INTERVAL="$4"

    : > "$LOG"

    while kill -0 "$PID" 2>/dev/null; do
        TS="$(date +%s 2>/dev/null)"
        PHASE="$(get_speedtest_phase "$OUTFILE")"
        SIG="$(get_signal_compact)"
        CA="$(get_ca_sample)"
        # timestamp|phase|6 signal fields|4 CA fields
        printf "%s|%s|%s|%s\n" "${TS:-0}" "$PHASE" "$SIG" "$CA" >> "$LOG"
        sleep "$INTERVAL"
    done

    TS="$(date +%s 2>/dev/null)"
    PHASE="$(get_speedtest_phase "$OUTFILE")"
    SIG="$(get_signal_compact)"
    CA="$(get_ca_sample)"
    printf "%s|%s|%s|%s\n" "${TS:-0}" "$PHASE" "$SIG" "$CA" >> "$LOG"
}

run_ui_speed_monitored() {
    DURATION="$1"
    OUTFILE="$2"
    MONFILE="$3"
    MODE="${4:-$SPEEDTEST_MODE_DEFAULT}"
    SERVER_ARG="$(speedtest_server_arg "$MODE")"

    if [ -n "$SERVER_ARG" ]; then
        ui-speed test \
            --intf "$WWAN_IF" \
            -d both \
            --durMax "$DURATION" \
            -o json \
            "$SERVER_ARG" > "$OUTFILE" 2>&1 &
    else
        ui-speed test \
            --intf "$WWAN_IF" \
            -d both \
            --durMax "$DURATION" \
            -o json > "$OUTFILE" 2>&1 &
    fi

    SPEED_PID=$!
    monitor_rf_ca "$SPEED_PID" "$OUTFILE" "$MONFILE" "$SPEEDTEST_MONITOR_INTERVAL" &
    MON_PID=$!

    wait "$SPEED_PID"
    RC=$?
    wait "$MON_PID" 2>/dev/null || true
    return "$RC"
}

summarize_monitor() {
    LOG="$1"

    if [ ! -s "$LOG" ]; then
        echo "0|0|0|0|n/a|n/a|n/a|n/a|n/a|0|0|0|0|0|0|n/a|n/a|n/a|n/a"
        return
    fi

    awk -F'|' '
        function num(v, x) {
            x=v; gsub(/[^0-9.-]/,"",x); return x+0
        }
        function range_update(v, type, n) {
            if (v=="" || v=="n/a") return
            n=num(v)
            if (type=="lr") {
                if (!lr_set || n<lr_min) lr_min=n
                if (!lr_set || n>lr_max) lr_max=n
                lr_set=1
            } else if (type=="ls") {
                if (!ls_set || n<ls_min) ls_min=n
                if (!ls_set || n>ls_max) ls_max=n
                ls_set=1
            } else if (type=="nr") {
                if (!nr_set || n<nr_min) nr_min=n
                if (!nr_set || n>nr_max) nr_max=n
                nr_set=1
            } else if (type=="ns") {
                if (!ns_set || n<ns_min) ns_min=n
                if (!ns_set || n>ns_max) ns_max=n
                ns_set=1
            }
        }
        {
            # Layout v8:
            # 1 ts, 2 phase,
            # 3 LTE_RSRP, 4 LTE_SNR, 5 LTE_RSRQ,
            # 6 NR_RSRP, 7 NR_SNR, 8 NR_RSRQ,
            # 9 CA active, 10 CA total, 11 primary, 12 scells
            phase=$2
            lte_rsrp=$3; lte_snr=$4
            nr_rsrp=$6; nr_snr=$7
            active=$9+0; total=$10+0
            sc=$12

            samples++
            if (active>0) active_samples++
            if (active>max_active) max_active=active
            if (total>max_total) max_total=total

            range_update(lte_rsrp,"lr")
            range_update(lte_snr,"ls")
            range_update(nr_rsrp,"nr")
            range_update(nr_snr,"ns")

            if (sc!="" && sc!="n/a") scells=sc

            if (phase=="down") {
                d_samples++
                if (active>0) d_active_samples++
                if (active>d_max_active) d_max_active=active

                if (lte_snr!="" && lte_snr!="n/a") {
                    n=num(lte_snr)
                    if (!dls_set || n<dls_min) dls_min=n
                    if (!dls_set || n>dls_max) dls_max=n
                    dls_set=1
                }
                if (nr_snr!="" && nr_snr!="n/a") {
                    n=num(nr_snr)
                    if (!dns_set || n<dns_min) dns_min=n
                    if (!dns_set || n>dns_max) dns_max=n
                    dns_set=1
                }
            }

            if (phase=="up") {
                u_samples++
                if (active>0) u_active_samples++
                if (active>u_max_active) u_max_active=active

                if (lte_snr!="" && lte_snr!="n/a") {
                    n=num(lte_snr)
                    if (!uls_set || n<uls_min) uls_min=n
                    if (!uls_set || n>uls_max) uls_max=n
                    uls_set=1
                }
                if (nr_snr!="" && nr_snr!="n/a") {
                    n=num(nr_snr)
                    if (!uns_set || n<uns_min) uns_min=n
                    if (!uns_set || n>uns_max) uns_max=n
                    uns_set=1
                }
            }
        }
        END {
            lr = lr_set ? sprintf("%.1f..%.1f",lr_min,lr_max) : "n/a"
            ls = ls_set ? sprintf("%.1f..%.1f",ls_min,ls_max) : "n/a"
            nr = nr_set ? sprintf("%.1f..%.1f",nr_min,nr_max) : "n/a"
            ns = ns_set ? sprintf("%.1f..%.1f",ns_min,ns_max) : "n/a"

            dls = dls_set ? sprintf("%.1f..%.1f",dls_min,dls_max) : "n/a"
            dns = dns_set ? sprintf("%.1f..%.1f",dns_min,dns_max) : "n/a"
            uls = uls_set ? sprintf("%.1f..%.1f",uls_min,uls_max) : "n/a"
            uns = uns_set ? sprintf("%.1f..%.1f",uns_min,uns_max) : "n/a"

            if (scells=="") scells="n/a"

            # Legacy 1..9:
            # samples, active_samples, max_active, max_total,
            # LTE RSRP range, LTE SNR range, NR RSRP range, NR SNR range, scells
            # New 10..19:
            # DL samples, DL CA-active samples, DL max active,
            # UL samples, UL CA-active samples, UL max active,
            # DL LTE SNR range, DL NR SNR range, UL LTE SNR range, UL NR SNR range
            printf "%d|%d|%d|%d|%s|%s|%s|%s|%s|%d|%d|%d|%d|%d|%d|%s|%s|%s|%s\n", \
                samples, active_samples, max_active, max_total, \
                lr, ls, nr, ns, scells, \
                d_samples, d_active_samples, d_max_active, \
                u_samples, u_active_samples, u_max_active, \
                dls, dns, uls, uns
        }
    ' "$LOG"
}

parse_json_number() {
    LINE="$1"
    KEY="$2"

    echo "$LINE" |
        sed -n "s/.*\"$KEY\":[ ]*\([0-9][0-9]*\).*/\1/p" |
        tail -n 1
}

parse_json_string() {
    LINE="$1"
    KEY="$2"

    echo "$LINE" |
        sed -n "s/.*\"$KEY\":\"\([^\"]*\)\".*/\1/p" |
        tail -n 1
}

bps_to_mbps() {
    VALUE="$1"

    if [ -z "$VALUE" ]; then
        echo "n/a"
    else
        awk -v v="$VALUE" 'BEGIN { printf "%.2f", v / 1000000 }'
    fi
}

describe_selected_server() {
    OUT="$1"
    MODE="$2"

    if [ "$MODE" = "fixed" ]; then
        echo "$SPEEDTEST_SERVER"
        return
    fi

    SERVER_LINE="$(echo "$OUT" | grep -Ei '"server"|"serverUrl"|"url"|"host"|"hostname"' | tail -n 1)"

    SELECTED="$(echo "$SERVER_LINE" |
        sed -n 's/.*"serverUrl":"\([^"]*\)".*/\1/p' |
        tail -n 1)"
    [ -z "$SELECTED" ] && SELECTED="$(echo "$SERVER_LINE" |
        sed -n 's/.*"url":"\([^"]*\)".*/\1/p' |
        tail -n 1)"
    [ -z "$SELECTED" ] && SELECTED="$(echo "$SERVER_LINE" |
        sed -n 's/.*"server":"\([^"]*\)".*/\1/p' |
        tail -n 1)"
    [ -z "$SELECTED" ] && SELECTED="$(echo "$SERVER_LINE" |
        sed -n 's/.*"host":"\([^"]*\)".*/\1/p' |
        tail -n 1)"
    [ -z "$SELECTED" ] && SELECTED="$(echo "$SERVER_LINE" |
        sed -n 's/.*"hostname":"\([^"]*\)".*/\1/p' |
        tail -n 1)"

    if [ -n "$SELECTED" ]; then
        echo "$SELECTED"
    else
        echo "automatic / not reported by ui-speed"
    fi
}

speedtest_warmup() {
    MODE="${1:-$SPEEDTEST_MODE_DEFAULT}"
    DURATION="${2:-$SPEEDTEST_WARMUP_DURATION}"

    TMP="/tmp/cellnet-warmup-$$-$(date +%s 2>/dev/null).json"
    SERVER_ARG="$(speedtest_server_arg "$MODE")"

    if [ -n "$SERVER_ARG" ]; then
        ui-speed test \
            --intf "$WWAN_IF" \
            -d both \
            --durMax "$DURATION" \
            -o json \
            "$SERVER_ARG" > "$TMP" 2>&1
    else
        ui-speed test \
            --intf "$WWAN_IF" \
            -d both \
            --durMax "$DURATION" \
            -o json > "$TMP" 2>&1
    fi

    RC=$?
    LAST="$(tail -n 1 "$TMP" 2>/dev/null)"
    ERR="$(grep '"err":' "$TMP" 2>/dev/null | tail -n 1 | sed -n 's/.*"msg":"\([^"]*\)".*/\1/p')"
    ERR="$(echo "$ERR" | tr '\n|' '  ' | sed 's/\\n/ /g')"

    rm -f "$TMP"

    if [ "$RC" -eq 0 ]; then
        echo "Warm-up completed."
        return 0
    fi

    echo "Warm-up returned rc=$RC; continuing with the main test."
    [ -n "$ERR" ] && echo "Warm-up error: $ERR"
    [ -n "$LAST" ] && echo "Warm-up last event: $LAST"
    return 0
}

speedtest_capture_once() {
    DURATION="$1"
    MODE="${2:-$SPEEDTEST_MODE_DEFAULT}"
    validate_duration "$DURATION"
    check_speedtest_requirements

    PLMN="$(get_current_plmn)"
    NAME="$(plmn_name "$PLMN")"

    RX_BEFORE="$(cat "/sys/class/net/$WWAN_IF/statistics/rx_bytes" 2>/dev/null)"
    TX_BEFORE="$(cat "/sys/class/net/$WWAN_IF/statistics/tx_bytes" 2>/dev/null)"

    TMPBASE="/tmp/cellnet-speed-$$-$(date +%s 2>/dev/null)"
    OUTFILE="${TMPBASE}.json"
    MONFILE="${TMPBASE}.monitor"

    run_ui_speed_monitored "$DURATION" "$OUTFILE" "$MONFILE" "$MODE"
    RC=$?

    OUT="$(cat "$OUTFILE" 2>/dev/null)"

    RX_AFTER="$(cat "/sys/class/net/$WWAN_IF/statistics/rx_bytes" 2>/dev/null)"
    TX_AFTER="$(cat "/sys/class/net/$WWAN_IF/statistics/tx_bytes" 2>/dev/null)"

    # Normal ui-speed success.
    FINAL="$(echo "$OUT" | grep '"state":5' | tail -n 1)"
    STATUS="OK"

    # If there is no state=5, preserve the latest partial result (state=7)
    # instead of discarding useful data.
    if [ -z "$FINAL" ]; then
        FINAL="$(echo "$OUT" | grep '"state":7' | tail -n 1)"
        [ -n "$FINAL" ] && STATUS="PARTIAL"
    fi

    # Last resort: use the latest line containing down/up values.
    if [ -z "$FINAL" ]; then
        FINAL="$(echo "$OUT" | grep -E '"down":[0-9]+|"up":[0-9]+' | tail -n 1)"
        [ -n "$FINAL" ] && STATUS="PARTIAL"
    fi

    RF_AFTER="$(get_signal_compact)"
    MON_SUMMARY="$(summarize_monitor "$MONFILE")"

    OLDIFS="$IFS"
    IFS='|'
    # Intentional split using IFS="|"; quoting would prevent field parsing.
    # shellcheck disable=SC2086
    set -- $RF_AFTER
    LTE_RSRP="$1"; LTE_SNR="$2"; LTE_RSRQ="$3"
    NR_RSRP="$4"; NR_SNR="$5"; NR_RSRQ="$6"

    # Intentional split using IFS="|"; quoting would prevent field parsing.
    # shellcheck disable=SC2086
    set -- $MON_SUMMARY
    MON_SAMPLES="$1"
    CA_ACTIVE_SAMPLES="$2"
    CA_MAX_ACTIVE="$3"
    CA_MAX_TOTAL="$4"
    LTE_RSRP_RANGE="$5"
    LTE_SNR_RANGE="$6"
    NR_RSRP_RANGE="$7"
    NR_SNR_RANGE="$8"
    CA_SCELLS="$9"
    shift 9
    DOWN_SAMPLES="$1"
    DOWN_CA_ACTIVE="$2"
    DOWN_CA_MAX="$3"
    UP_SAMPLES="$4"
    UP_CA_ACTIVE="$5"
    UP_CA_MAX="$6"
    DOWN_LTE_SNR_RANGE="$7"
    DOWN_NR_SNR_RANGE="$8"
    UP_LTE_SNR_RANGE="$9"
    shift 9
    UP_NR_SNR_RANGE="$1"
    IFS="$OLDIFS"

    RX_DELTA="n/a"
    TX_DELTA="n/a"
    [ -n "$RX_BEFORE" ] && [ -n "$RX_AFTER" ] && RX_DELTA=$((RX_AFTER - RX_BEFORE))
    [ -n "$TX_BEFORE" ] && [ -n "$TX_AFTER" ] && TX_DELTA=$((TX_AFTER - TX_BEFORE))

    if [ -z "$FINAL" ]; then
        rm -f "$OUTFILE" "$MONFILE"
        printf "%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s\n" \
            "ERROR" "$NAME" "$PLMN" \
            "n/a" "n/a" "n/a" "n/a" "n/a" \
            "${LTE_RSRP:-n/a}" "${LTE_SNR:-n/a}" "${LTE_RSRQ:-n/a}" \
            "${NR_RSRP:-n/a}" "${NR_SNR:-n/a}" "${NR_RSRQ:-n/a}" \
            "$RX_DELTA" "$TX_DELTA" "$RC" \
            "${MON_SAMPLES:-0}" "${CA_ACTIVE_SAMPLES:-0}" "${CA_MAX_ACTIVE:-0}" "${CA_MAX_TOTAL:-0}" \
            "${LTE_RSRP_RANGE:-n/a}" "${LTE_SNR_RANGE:-n/a}" \
            "${NR_RSRP_RANGE:-n/a}" "${NR_SNR_RANGE:-n/a}" "${CA_SCELLS:-n/a}" \
            "ui-speed returned no usable result" \
            "${DOWN_SAMPLES:-0}" "${DOWN_CA_ACTIVE:-0}" "${DOWN_CA_MAX:-0}" \
            "${UP_SAMPLES:-0}" "${UP_CA_ACTIVE:-0}" "${UP_CA_MAX:-0}" \
            "${DOWN_LTE_SNR_RANGE:-n/a}" "${DOWN_NR_SNR_RANGE:-n/a}" \
            "${UP_LTE_SNR_RANGE:-n/a}" "${UP_NR_SNR_RANGE:-n/a}" \
            "$MODE" "$(speedtest_mode_label "$MODE")"
        return 1
    fi

    DOWN_BPS="$(parse_json_number "$FINAL" "down")"
    UP_BPS="$(parse_json_number "$FINAL" "up")"
    LATENCY="$(parse_json_number "$FINAL" "latency")"

    IP_LINE="$(echo "$OUT" | grep '"ipStats"' | tail -n 1)"
    PUBLIC_IP="$(parse_json_string "$IP_LINE" "ip")"
    ISP="$(parse_json_string "$IP_LINE" "isp")"

    SELECTED_SERVER="$(describe_selected_server "$OUT" "$MODE")"

    DOWN_MBPS="$(bps_to_mbps "$DOWN_BPS")"
    UP_MBPS="$(bps_to_mbps "$UP_BPS")"

    ERRMSG="$(echo "$FINAL" | sed -n 's/.*"msg":"\([^"]*\)".*/\1/p' | tail -n 1)"
    [ -z "$ERRMSG" ] && ERRMSG="$(echo "$OUT" | grep '"err":' | tail -n 1 | sed -n 's/.*"msg":"\([^"]*\)".*/\1/p')"
    ERRMSG="$(echo "$ERRMSG" | tr '\n|' '  ' | sed 's/\\n/ /g')"
    [ -z "$ERRMSG" ] && ERRMSG="none"

    rm -f "$OUTFILE" "$MONFILE"

    printf "%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s\n" \
        "$STATUS" "$NAME" "$PLMN" \
        "${PUBLIC_IP:-n/a}" "${ISP:-n/a}" \
        "$DOWN_MBPS" "$UP_MBPS" "${LATENCY:-n/a}" \
        "${LTE_RSRP:-n/a}" "${LTE_SNR:-n/a}" "${LTE_RSRQ:-n/a}" \
        "${NR_RSRP:-n/a}" "${NR_SNR:-n/a}" "${NR_RSRQ:-n/a}" \
        "$RX_DELTA" "$TX_DELTA" "$RC" \
        "${MON_SAMPLES:-0}" "${CA_ACTIVE_SAMPLES:-0}" "${CA_MAX_ACTIVE:-0}" "${CA_MAX_TOTAL:-0}" \
        "${LTE_RSRP_RANGE:-n/a}" "${LTE_SNR_RANGE:-n/a}" \
        "${NR_RSRP_RANGE:-n/a}" "${NR_SNR_RANGE:-n/a}" "${CA_SCELLS:-n/a}" \
        "$ERRMSG" \
        "${DOWN_SAMPLES:-0}" "${DOWN_CA_ACTIVE:-0}" "${DOWN_CA_MAX:-0}" \
        "${UP_SAMPLES:-0}" "${UP_CA_ACTIVE:-0}" "${UP_CA_MAX:-0}" \
        "${DOWN_LTE_SNR_RANGE:-n/a}" "${DOWN_NR_SNR_RANGE:-n/a}" \
        "${UP_LTE_SNR_RANGE:-n/a}" "${UP_NR_SNR_RANGE:-n/a}" \
        "$MODE" "${SELECTED_SERVER:-auto}"

    [ "$STATUS" = "OK" ]
}

speedtest_capture() {
    DURATION="$1"
    MODE="${2:-$SPEEDTEST_MODE_DEFAULT}"

    ATTEMPT=0
    MAX_ATTEMPTS=$((SPEEDTEST_RETRIES + 1))
    LAST_RECORD=""

    while [ "$ATTEMPT" -lt "$MAX_ATTEMPTS" ]; do
        ATTEMPT=$((ATTEMPT + 1))

        RECORD="$(speedtest_capture_once "$DURATION" "$MODE")"
        RC=$?
        LAST_RECORD="$RECORD"

        STATUS="$(echo "$RECORD" | awk -F'|' '{print $1}')"

        if [ "$STATUS" = "OK" ]; then
            echo "$RECORD"
            return 0
        fi

        if [ "$ATTEMPT" -lt "$MAX_ATTEMPTS" ]; then
            LAST_ERR="$(echo "$RECORD" | awk -F'|' '{print $27}')"
            FIELD_COUNT="$(echo "$RECORD" | awk -F'|' '{print NF}')"
            echo "WARNING: incomplete speed test on attempt $ATTEMPT/$MAX_ATTEMPTS (${FIELD_COUNT}-field record)." >&2
            [ -n "$LAST_ERR" ] && [ "$LAST_ERR" != "none" ] && echo "Reason: $LAST_ERR" >&2
            echo "Retrying in ${SPEEDTEST_RETRY_WAIT}s..." >&2
            sleep "$SPEEDTEST_RETRY_WAIT"
        fi
    done

    echo "$LAST_RECORD"
    return 1
}

print_speed_record() {
    RECORD="$1"

    OLDIFS="$IFS"
    IFS='|'
    # Intentional split using IFS="|"; quoting would prevent field parsing.
    # shellcheck disable=SC2086
    set -- $RECORD
    IFS="$OLDIFS"

    STATUS="$1"
    NAME="$2"
    PLMN="$3"
    PUBLIC_IP="$4"
    ISP="$5"
    DOWN="$6"
    UP="$7"
    LATENCY="$8"
    LTE_RSRP="$9"
    shift 9
    LTE_SNR="$1"
    LTE_RSRQ="$2"
    NR_RSRP="$3"
    NR_SNR="$4"
    NR_RSRQ="$5"
    RX_DELTA="$6"
    TX_DELTA="$7"
    MON_SAMPLES="$9"
    shift 9
    CA_ACTIVE_SAMPLES="$1"
    CA_MAX_ACTIVE="$2"
    CA_MAX_TOTAL="$3"
    LTE_RSRP_RANGE="$4"
    LTE_SNR_RANGE="$5"
    NR_RSRP_RANGE="$6"
    NR_SNR_RANGE="$7"
    CA_SCELLS="$8"
    ERRMSG="$9"
    shift 9
    DOWN_SAMPLES="$1"
    DOWN_CA_ACTIVE="$2"
    DOWN_CA_MAX="$3"
    UP_SAMPLES="$4"
    UP_CA_ACTIVE="$5"
    UP_CA_MAX="$6"
    DOWN_LTE_SNR_RANGE="$7"
    DOWN_NR_SNR_RANGE="$8"
    UP_LTE_SNR_RANGE="$9"
    shift 9
    UP_NR_SNR_RANGE="$1"
    shift
    SPEED_MODE="$1"
    SELECTED_SERVER="$2"

    if [ "$STATUS" = "ERROR" ]; then
        echo "Speed test failed without a usable result."
        [ "$ERRMSG" != "none" ] && echo "Error: $ERRMSG"
        return 1
    fi

    [ "$STATUS" = "PARTIAL" ] && echo "WARNING: PARTIAL result; ui-speed did not reach state=5."

    printf "%-22s %s\n" "Status:" "$STATUS"
    printf "%-22s %s\n" "Carrier:" "$NAME"
    printf "%-22s %s\n" "PLMN:" "$PLMN"
    printf "%-22s %s\n" "Interface:" "$WWAN_IF"
    printf "%-22s %s\n" "Server mode:" "$(speedtest_mode_label "$SPEED_MODE")"
    [ -z "$SELECTED_SERVER" ] && SELECTED_SERVER="automatic / not reported by ui-speed"
    printf "%-22s %s\n" "Server used:" "$SELECTED_SERVER"
    printf "%-22s %s\n" "Public IP:" "$PUBLIC_IP"
    printf "%-22s %s\n" "ISP:" "$ISP"
    printf "%-22s %s Mbps\n" "Download:" "$DOWN"
    printf "%-22s %s Mbps\n" "Upload:" "$UP"
    printf "%-22s %s ms\n" "Latency:" "$LATENCY"
    printf "%-22s %s\n" "LTE RSRP:" "$LTE_RSRP"
    printf "%-22s %s\n" "LTE SNR:" "$LTE_SNR"
    printf "%-22s %s\n" "LTE RSRQ:" "$LTE_RSRQ"
    printf "%-22s %s\n" "5G RSRP:" "$NR_RSRP"
    printf "%-22s %s\n" "5G SNR:" "$NR_SNR"
    printf "%-22s %s\n" "5G RSRQ:" "$NR_RSRQ"
    printf "%-22s %s bytes\n" "wwan0 RX delta:" "$RX_DELTA"
    printf "%-22s %s bytes\n" "wwan0 TX delta:" "$TX_DELTA"
    printf "%-22s %s\n" "RF/CA samples:" "$MON_SAMPLES"
    printf "%-22s %s/%s\n" "CA-active samples:" "$CA_ACTIVE_SAMPLES" "$MON_SAMPLES"
    printf "%-22s %s\n" "Max active SCells:" "$CA_MAX_ACTIVE"
    printf "%-22s %s\n" "Max observed SCells:" "$CA_MAX_TOTAL"
    printf "%-22s %s\n" "LTE RSRP during test:" "$LTE_RSRP_RANGE"
    printf "%-22s %s\n" "LTE SNR during test:" "$LTE_SNR_RANGE"
    printf "%-22s %s\n" "5G RSRP during test:" "$NR_RSRP_RANGE"
    printf "%-22s %s\n" "5G SNR during test:" "$NR_SNR_RANGE"
    printf "%-22s %s\n" "Observed SCells:" "$CA_SCELLS"

    echo
    echo "CA / RF BY PHASE"
    printf "%-22s %s/%s\n" "DL CA active:" "$DOWN_CA_ACTIVE" "$DOWN_SAMPLES"
    printf "%-22s %s\n" "DL Max SCells:" "$DOWN_CA_MAX"
    printf "%-22s %s\n" "DL LTE SNR:" "$DOWN_LTE_SNR_RANGE"
    printf "%-22s %s\n" "DL 5G SNR:" "$DOWN_NR_SNR_RANGE"
    printf "%-22s %s/%s\n" "UL CA active:" "$UP_CA_ACTIVE" "$UP_SAMPLES"
    printf "%-22s %s\n" "UL Max SCells:" "$UP_CA_MAX"
    printf "%-22s %s\n" "UL LTE SNR:" "$UP_LTE_SNR_RANGE"
    printf "%-22s %s\n" "UL 5G SNR:" "$UP_NR_SNR_RANGE"

    if [ "$STATUS" = "PARTIAL" ] && [ "$ERRMSG" != "none" ]; then
        printf "%-22s %s\n" "ui-speed error:" "$ERRMSG"
    fi

    [ "$STATUS" = "OK" ]
}


speedtest_current() {
    DURATION="${1:-$SPEEDTEST_DURATION}"
    MODE="${2:-$SPEEDTEST_MODE_DEFAULT}"

    validate_duration "$DURATION"
    check_speedtest_requirements

    separator
    echo "SPEEDTEST MOBILE"
    separator
    echo "Forced interface: $WWAN_IF"
    echo "Server:          $(speedtest_mode_label "$MODE")"
    echo "Duration:           ${DURATION}s"
    echo

    # Standalone speed test:
    # - if NSA is already active, start immediately;
    # - if NSA is not active yet, wait for activation/stabilization.
    # Does not change PLMN or reconnect the carrier.
    if check_5g_nsa_ready; then
        echo "Starting speed test without additional delay."
    else
        wait_5g_nsa || true
    fi

    echo
    echo "Running short warm-up (${SPEEDTEST_WARMUP_DURATION}s)..."
    speedtest_warmup "$MODE" "$SPEEDTEST_WARMUP_DURATION"
    sleep "$SPEEDTEST_WARMUP_WAIT"

    RECORD="$(speedtest_capture "$DURATION" "$MODE")"
    RC=$?

    echo
    print_speed_record "$RECORD"

    return "$RC"
}

speedtest_fixed() {
    DURATION="${1:-$SPEEDTEST_DURATION}"
    speedtest_current "$DURATION" fixed
}

field_from_record() {
    RECORD="$1"
    INDEX="$2"
    echo "$RECORD" | awk -F'|' -v n="$INDEX" '{print $n}'
}

failed_speed_record() {
    FAILED_NAME="$1"
    FAILED_PLMN="$2"
    FAILED_MODE="$3"
    FAILED_REASON="$4"

    printf "%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s\n" \
        "ERROR" "$FAILED_NAME" "$FAILED_PLMN" \
        "n/a" "n/a" "n/a" "n/a" "n/a" \
        "n/a" "n/a" "n/a" "n/a" "n/a" "n/a" \
        "n/a" "n/a" "1" \
        "0" "0" "0" "0" \
        "n/a" "n/a" "n/a" "n/a" "n/a" \
        "$FAILED_REASON" \
        "0" "0" "0" "0" "0" "0" \
        "n/a" "n/a" "n/a" "n/a" \
        "$FAILED_MODE" "$(speedtest_mode_label "$FAILED_MODE")"
}

compare_speed() {
    DURATION="${1:-$SPEEDTEST_DURATION}"
    MODE="${2:-$SPEEDTEST_MODE_DEFAULT}"
    validate_duration "$DURATION"
    check_speedtest_requirements

    echo
    echo "============================================================"
    echo " TIM x VIVO SPEED TEST COMPARISON"
    echo "============================================================"
    echo
    echo "Interface: $WWAN_IF"
    echo "Server:  $(speedtest_mode_label "$MODE")"
    echo "Duration:   ${DURATION}s per carrier"
    echo "Does not change RAT or bands."
    echo

    TIM_RESULT=""
    VIVO_RESULT=""
    COMPARE_FAILED=0

    echo "==================== TIM ===================="
    if set_manual_network "TIM" "$TIM_PLMN"; then
        echo "Warm-up TIM (${SPEEDTEST_WARMUP_DURATION}s)..."
        speedtest_warmup "$MODE" "$SPEEDTEST_WARMUP_DURATION"
        sleep "$SPEEDTEST_WARMUP_WAIT"
        TIM_RESULT="$(speedtest_capture "$DURATION" "$MODE")"
        [ "$(field_from_record "$TIM_RESULT" 1)" = "OK" ] || COMPARE_FAILED=1
        echo
        print_speed_record "$TIM_RESULT" || true
    else
        TIM_RESULT="$(failed_speed_record "TIM" "$TIM_PLMN" "$MODE" "carrier registration failed")"
        COMPARE_FAILED=1
        echo "Failed to register on TIM."
    fi

    echo
    echo "=================== VIVO ===================="
    if set_manual_network "VIVO" "$VIVO_PLMN"; then
        echo "Warm-up VIVO (${SPEEDTEST_WARMUP_DURATION}s)..."
        speedtest_warmup "$MODE" "$SPEEDTEST_WARMUP_DURATION"
        sleep "$SPEEDTEST_WARMUP_WAIT"
        VIVO_RESULT="$(speedtest_capture "$DURATION" "$MODE")"
        [ "$(field_from_record "$VIVO_RESULT" 1)" = "OK" ] || COMPARE_FAILED=1
        echo
        print_speed_record "$VIVO_RESULT" || true
    else
        VIVO_RESULT="$(failed_speed_record "VIVO" "$VIVO_PLMN" "$MODE" "carrier registration failed")"
        COMPARE_FAILED=1
        echo "Failed to register on VIVO."
    fi

    echo
    echo "============================================================"
    echo " TIM x VIVO SUMMARY"
    echo "============================================================"

    printf "%-22s %-18s %-18s\n" "Metric" "TIM" "VIVO"
    separator

    printf "%-22s %-18s %-18s\n" "Result status" \
        "$(field_from_record "$TIM_RESULT" 1)" \
        "$(field_from_record "$VIVO_RESULT" 1)"

    printf "%-22s %-18s %-18s\n" "Download Mbps" \
        "$(field_from_record "$TIM_RESULT" 6)" \
        "$(field_from_record "$VIVO_RESULT" 6)"

    printf "%-22s %-18s %-18s\n" "Upload Mbps" \
        "$(field_from_record "$TIM_RESULT" 7)" \
        "$(field_from_record "$VIVO_RESULT" 7)"

    printf "%-22s %-18s %-18s\n" "Latency ms" \
        "$(field_from_record "$TIM_RESULT" 8)" \
        "$(field_from_record "$VIVO_RESULT" 8)"

    printf "%-22s %-18s %-18s\n" "LTE RSRP" \
        "$(field_from_record "$TIM_RESULT" 9)" \
        "$(field_from_record "$VIVO_RESULT" 9)"

    printf "%-22s %-18s %-18s\n" "LTE SNR" \
        "$(field_from_record "$TIM_RESULT" 10)" \
        "$(field_from_record "$VIVO_RESULT" 10)"

    printf "%-22s %-18s %-18s\n" "5G RSRP" \
        "$(field_from_record "$TIM_RESULT" 12)" \
        "$(field_from_record "$VIVO_RESULT" 12)"

    printf "%-22s %-18s %-18s\n" "5G SNR" \
        "$(field_from_record "$TIM_RESULT" 13)" \
        "$(field_from_record "$VIVO_RESULT" 13)"

    printf "%-22s %-18s %-18s\n" "5G RSRQ" \
        "$(field_from_record "$TIM_RESULT" 14)" \
        "$(field_from_record "$VIVO_RESULT" 14)"

    printf "%-22s %-18s %-18s\n" "CA active samples" \
        "$(field_from_record "$TIM_RESULT" 19)/$(field_from_record "$TIM_RESULT" 18)" \
        "$(field_from_record "$VIVO_RESULT" 19)/$(field_from_record "$VIVO_RESULT" 18)"

    printf "%-22s %-18s %-18s\n" "Max active SCells" \
        "$(field_from_record "$TIM_RESULT" 20)" \
        "$(field_from_record "$VIVO_RESULT" 20)"

    printf "%-22s %-18s %-18s\n" "DL CA active" \
        "$(field_from_record "$TIM_RESULT" 28)/$(field_from_record "$TIM_RESULT" 27)" \
        "$(field_from_record "$VIVO_RESULT" 28)/$(field_from_record "$VIVO_RESULT" 27)"

    printf "%-22s %-18s %-18s\n" "DL Max SCells" \
        "$(field_from_record "$TIM_RESULT" 29)" \
        "$(field_from_record "$VIVO_RESULT" 29)"

    printf "%-22s %-18s %-18s\n" "UL CA active" \
        "$(field_from_record "$TIM_RESULT" 31)/$(field_from_record "$TIM_RESULT" 30)" \
        "$(field_from_record "$VIVO_RESULT" 31)/$(field_from_record "$VIVO_RESULT" 30)"

    printf "%-22s %-18s %-18s\n" "UL Max SCells" \
        "$(field_from_record "$TIM_RESULT" 32)" \
        "$(field_from_record "$VIVO_RESULT" 32)"

    printf "%-22s %-18s %-18s\n" "Public IP" \
        "$(field_from_record "$TIM_RESULT" 4)" \
        "$(field_from_record "$VIVO_RESULT" 4)"

    printf "%-22s %-18s %-18s\n" "Server" \
        "$(field_from_record "$TIM_RESULT" 39)" \
        "$(field_from_record "$VIVO_RESULT" 39)"

    echo
    echo "The modem will remain on VIVO."
    echo "Use '$0 tim' or '$0 auto' if you want to change it afterwards."
    return "$COMPARE_FAILED"
}

compare_speed_fixed() {
    DURATION="${1:-$SPEEDTEST_DURATION}"
    compare_speed "$DURATION" fixed
}

usage() {
    cat <<EOF
Version: $CELLNET_BASELINE_VERSION

Usage:

  $0 tim
      Force TIM PLMN $TIM_PLMN.
      Wait for registration and then wait for 5G NSA.

  $0 vivo
      Force VIVO PLMN $VIVO_PLMN.
      Wait for registration and then wait for 5G NSA.

  $0 auto
      Return carrier selection to automatic mode.

  $0 status
      Show a compact status summary.

  $0 full
      Show complete network, signal, cell and RF status.

  $0 signal
      Show RSRP / RSRQ / SNR.

  $0 cell
      Show serving cell and frequency information.

  $0 radio
      Show LTE, 5G NSA and 5G SA information.

  $0 rf
      Show bands, LTE CA, serving cell and signal information.

  $0 cells
      Show a normalized serving-cell and radio summary.

  $0 tower-id
      Show identifiers for external tower correlation without an Internet lookup.

  $0 neighbors
      Show the modem's read-only cell-location and neighboring-cell response.

  $0 tower-export [json|csv]
      Export serving-cell identifiers in a structured format.

  $0 tower-lookup [latitude longitude]
      Query OpenCellID for the current LTE cell and calculate distance/bearing.
      Requires OPENCELLID_API_KEY and device coordinates as arguments or via
      CELLNET_LATITUDE and CELLNET_LONGITUDE.

  $0 observe-cells [seconds]
      Emit timestamped serving-cell and RF samples as CSV.

  $0 tower-assess latitude longitude [seconds]
      Combine OpenCellID proximity with a read-only RF stability summary.

  $0 tower-assess-speed latitude longitude [seconds]
      Add a cellular speed test to tower-assess. Consumes cellular data.

  $0 watch [seconds]
      Monitor RF and cell changes without generating data traffic.
      Default duration: 60 seconds.

  $0 stability [seconds]
      Summarize RF ranges and cell changes without a speed test.
      Default duration: 60 seconds.

  $0 preferences
      Show current network/RAT preferences.

  $0 scan
      Scan available carriers.

  $0 snapshot [name]
      Capture a network/RF snapshot.

  $0 compare
      Switch TIM -> VIVO and capture RF snapshots.

  $0 speedtest [seconds]
      Run a speed test on the current cellular network.
      FORCES --intf $WWAN_IF.
      Uses -d both.
      Server is automatically selected by ui-speed.
      Monitors signal and LTE CA during the test.

  $0 speedtest-fixed [seconds]
      Run the same test using the fixed Ubiquiti server:
      $SPEEDTEST_SERVER

  $0 compare-speed [seconds]
      Compare TIM x VIVO using automatic server selection
      independently for each carrier.
      FORCES tests through interface $WWAN_IF.
      Also compares LTE Carrier Aggregation activity.

  $0 compare-speed-fixed [seconds]
      Compare TIM x VIVO using the SAME fixed Ubiquiti server.

Examples:

  $0 tim
  $0 vivo
  $0 status
  $0 rf
  $0 cells
  $0 tower-id
  $0 neighbors
  $0 tower-export json
  $0 tower-lookup -23.5505 -46.6333
  $0 observe-cells 180
  $0 tower-assess -23.5505 -46.6333 60
  $0 watch 60
  $0 stability 60
  $0 speedtest
  $0 speedtest 15
  $0 speedtest-fixed 15
  $0 compare
  $0 compare-speed
  $0 compare-speed 15
  $0 compare-speed-fixed 15

PLMNs:

  TIM   = $TIM_PLMN
  VIVO  = $VIVO_PLMN

Speed test:

  Retries    = ${SPEEDTEST_RETRIES}
  Retry wait = ${SPEEDTEST_RETRY_WAIT}s
  RF/CA poll = ${SPEEDTEST_MONITOR_INTERVAL}s
  Warm-up    = ${SPEEDTEST_WARMUP_DURATION}s

  Interface  = $WWAN_IF
  Default    = automatic server selection
  Fixed      = $SPEEDTEST_SERVER
  Duration   = ${SPEEDTEST_DURATION}s

IMPORTANT:

  The script does NOT use:

      5gnr,manual=...
      lte,manual=...

  because these parameters alter the modem Mode Preference/RAT settings.

EOF
}

check_requirements

CMD="${1:-help}"
ARG2="${2:-}"
ARG3="${3:-}"
ARG4="${4:-}"

case "$CMD" in
    tim)
        set_manual_network "TIM" "$TIM_PLMN"
        ;;

    vivo)
        set_manual_network "VIVO" "$VIVO_PLMN"
        ;;

    auto)
        set_auto
        ;;

    status)
        short_status
        ;;

    full)
        full_status
        ;;

    signal)
        signal_status
        ;;

    cell)
        cell_status
        ;;

    radio)
        radio_status
        ;;

    rf)
        rf_status
        ;;

    cells)
        cells_summary
        ;;

    tower-id)
        tower_id
        ;;

    neighbors)
        neighbors
        ;;

    tower-export)
        tower_export "${ARG2:-json}"
        ;;

    tower-lookup)
        tower_lookup "$ARG2" "$ARG3"
        ;;

    observe-cells)
        observe_cells "${ARG2:-60}"
        ;;

    tower-assess)
        tower_assess "$ARG2" "$ARG3" "$ARG4"
        ;;

    tower-assess-speed)
        tower_assess_speed "$ARG2" "$ARG3" "$ARG4"
        ;;

    watch)
        watch_radio "${ARG2:-60}"
        ;;

    stability)
        stability_summary "${ARG2:-60}"
        ;;

    preferences)
        preferences
        ;;

    scan)
        scan_networks
        ;;

    snapshot)
        snapshot "$ARG2"
        ;;

    compare)
        compare_networks
        ;;

    speedtest)
        speedtest_current "${ARG2:-$SPEEDTEST_DURATION}" auto
        ;;

    speedtest-fixed)
        speedtest_fixed "${ARG2:-$SPEEDTEST_DURATION}"
        ;;

    compare-speed)
        compare_speed "${ARG2:-$SPEEDTEST_DURATION}" auto
        ;;

    compare-speed-fixed)
        compare_speed_fixed "${ARG2:-$SPEEDTEST_DURATION}"
        ;;

    help|-h|--help|"")
        usage
        ;;

    *)
        echo "Unknown option: $CMD"
        usage
        exit 1
        ;;
esac
